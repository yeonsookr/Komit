# 서버 전용 — 브라우저에 노출되지 않습니다. NEXT_PUBLIC_ 을 붙이지 마세요.
#
# 기본 FE는 실제 Service를 봅니다. 로컬은 Service의 기본 포트를 사용하고, 운영 CI/CD는
# 빌드 컨테이너에서도 접근 가능한 https://komit.site/service 를 사용합니다.
BACKEND_API_BASE_URL=http://localhost:8080

# 기본 FE는 비워 두고, /test 이미지를 빌드할 때만 /test를 넣습니다.
BASE_PATH=

# 카카오 로그인 — 카카오 개발자 콘솔의 REST API 키와, 콘솔에 등록한 Redirect URI.
# Redirect URI 는 콘솔 값과 글자까지 같아야 하며, 우리 쪽 콜백 Route Handler 를 가리킵니다.
#   로컬  http://localhost:3000/api/auth/kakao/callback
#   배포  https://komit.site/api/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# GitLab CI/CD에서는 /test 이미지에 아래 별도 변수들을 사용합니다.
# TEST_BACKEND_API_BASE_URL=https://komit.site/mock/service
# TEST_KAKAO_REDIRECT_URI=https://komit.site/test/api/auth/kakao/callback
