# 서버 전용 — 브라우저에 노출되지 않습니다. NEXT_PUBLIC_ 을 붙이지 마세요.
#
# 목 서버는 코밋(/service)과 에스크로(/escrow) 두 앱으로 나뉩니다.
# 배포본에는 nginx 가 /mock 을 앞에 붙이므로 base URL 에 함께 적습니다.
#   배포  https://komit.site/mock/service   (문서 https://komit.site/mock/service/docs)
#   로컬  http://localhost:8080/service     (mock/ 에서 uvicorn 으로 띄울 때)
BACKEND_API_BASE_URL=https://komit.site/mock/service
ESCROW_API_BASE_URL=https://komit.site/mock/escrow
AI_API_BASE_URL=https://komit.site/mock/service

# 카카오 로그인 — 카카오 개발자 콘솔의 REST API 키와, 콘솔에 등록한 Redirect URI.
# Redirect URI 는 콘솔 값과 글자까지 같아야 하며, 우리 쪽 콜백 Route Handler 를 가리킵니다.
#   로컬  http://localhost:3000/api/auth/kakao/callback
#   배포  https://komit.site/api/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 공개 — 메타데이터, canonical URL 등 노출되어도 되는 값만 둡니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
