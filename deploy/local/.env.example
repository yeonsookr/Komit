# deploy/local/.env 로 복사해 채웁니다. .env 는 커밋하지 않습니다.

# 카카오 개발자 콘솔 > 앱 키 > REST API 키, 보안 > Client Secret.
# 콘솔의 Redirect URI 에 http://localhost:3000/api/auth/kakao/callback 이 등록되어 있어야 합니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# AI 서버 주소. 비우면 목 서버를 씁니다.
AI_API_BASE_URL=https://komit.site/mock/service
