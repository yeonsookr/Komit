# service/.env로 복사해 사용합니다. service/.env는 Git에 커밋하지 않습니다.

# 로컬 MongoDB. deploy/local/docker-compose.yml의 기본 계정과 같습니다.
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=service
MONGODB_USERNAME=service
MONGODB_PASSWORD=service

# Service가 확인 문장 후보를 받아 오는 AI 서비스 주소입니다. 띄우는 법은
# ai/worker/README.md 에 있습니다. 안 띄우면 그 요청만 503이 됩니다.
AI_API_BASE_URL=http://localhost:8000

# Service는 실제 Escrow를 호출합니다. 클라이언트가 아래 base URL 뒤에
# /api/v1/... 경로를 붙이므로 base URL에는 /api를 넣지 않습니다.
ESCROW_API_BASE_URL=http://localhost:8081
ESCROW_CLIENT_API_KEY=komit-backend-client-api-key-dev-only

# Mock을 명시적으로 테스트할 때만 아래 값으로 교체합니다.
# ESCROW_API_BASE_URL=https://komit.site/mock/escrow
# ESCROW_CLIENT_API_KEY=mock-client-api-key
