# service/.env로 복사해 사용합니다. service/.env는 Git에 커밋하지 않습니다.

# Backend 개발 중에는 실제 Escrow 대신 Mock Server를 호출합니다.
ESCROW_API_BASE_URL=https://komit.site/mock/escrow
ESCROW_CLIENT_API_KEY=mock-client-api-key

# 실제 로컬 Escrow 통합 테스트 시에만 아래 형태로 교체합니다.
# ESCROW_API_BASE_URL=http://localhost:8081/api
# ESCROW_CLIENT_API_KEY=komit_be_<발급한 실제 키>
