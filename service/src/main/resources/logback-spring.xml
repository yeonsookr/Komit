<?xml version="1.0" encoding="UTF-8"?>
<!--
  콘솔 로그 형식. (BACKEND_CONVENTIONS 18)

  이중화 환경에서 어느 인스턴스가 처리했는지 알 수 있도록 앱 이름·인스턴스·배포 버전을 모든 줄에 붙이고,
  한 요청의 로그를 묶어 볼 수 있도록 common/logging/TraceIdFilter 가 MDC에 넣은 traceId 를 함께 찍습니다.

  - appName    : spring.application.name
  - instanceId : 컨테이너 호스트명(k3s 파드 이름). 없으면 local
  - appVersion : 배포 파이프라인이 넣는 APP_VERSION 환경변수. 없으면 dev
  - traceId    : 요청마다 새로 만든 임의 식별자. 요청 밖(기동·스케줄러)에서는 비어 있습니다.

  로그 레벨은 여기서 정하지 않고 application*.yml 의 logging.level 이 정합니다.
-->
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="service"/>

    <property name="instanceId" value="${HOSTNAME:-local}"/>
    <property name="appVersion" value="${APP_VERSION:-dev}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} %5p [${appName},${instanceId},${appVersion}] [%X{traceId:-}] %-40.40logger{39} : %m%n%ex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
